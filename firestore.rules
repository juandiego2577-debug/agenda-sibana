rules_version = '2';
// Reglas de Firestore de la agenda y de la ficha de consentimiento.
// Este archivo solo guarda el texto: para que tengan efecto hay que pegarlas
// a mano en Firebase Console → Firestore Database → Reglas → Publicar.
//
// Qué hacen:
// - Cada sede solo la puede leer/escribir su propio equipo, más los dueños.
//   El equipo entra con la cuenta compartida de su sede o con su usuario
//   personal (sibana-usuarios, ver más abajo).
//   El equipo de Buenos Aires no puede ver nada de Santiago, ni al revés.
//   El documento de la agenda nunca se puede borrar entero.
// - Respaldos diarios ("<sede>_YYYY-MM-DD") y copias de antes de restaurar
//   ("<sede>_antes-restaurar-<fecha>"): misma regla de sede, pero una vez
//   creados NO se pueden modificar, y solo se pueden borrar los que tienen más
//   de 29 días (la agenda borra los de más de 30; el día de margen es por las
//   zonas horarias). Así, aunque alguien consiga la contraseña del equipo, no
//   puede borrar ni pisar los respaldos recientes. Solo se pueden crear con la
//   fecha de hoy (± 2 días), para que nadie "reserve" respaldos de días
//   futuros con datos falsos. El índice ("<sede>_indice") sí se actualiza.
// - Fichas de consentimiento: cualquiera puede FIRMAR (crear) con la sesión
//   anónima invisible, pero solo el equipo de esa sede (y los dueños) puede
//   leerlas o borrarlas (nadie puede modificar una ficha ya firmada). La
//   firma tiene que ser una imagen PNG de verdad (antes se aceptaba
//   cualquier texto, y un texto armado a propósito
//   podía meter un programa en la agenda al mostrar la ficha) y la ficha de
//   Santiago solo puede traer los campos que usa el formulario, con textos
//   de largo razonable.
service cloud.firestore {
  match /databases/{database}/documents {
    function conCuenta() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function correo() {
      return request.auth.token.email;
    }
    // Las cuentas usan Gmail de verdad (desde el 04/10/2026): las del equipo,
    // el de Sibana; la de dueños, el Gmail PERSONAL de Juan Diego (así nadie
    // que pueda abrir el correo de Sibana puede pedir "olvidé mi contraseña"
    // de la cuenta de dueños y recibir el enlace). Las de antes
    // (equipo@sibanasantiago.app, equipo@sibanabuenosaires.app,
    // duenos@sibana.app) eran de dominios que no son de Sibana: quien los
    // comprara podía pedir "olvidé mi contraseña" y quedarse con la cuenta.
    // Por eso ya no tienen acceso, aunque sigan existiendo. OJO: nunca borrar
    // una cuenta cuyo correo siga aquí (cualquiera podría volver a crearla con
    // ese correo y entrar): primero se saca de las reglas, después se borra.
    // Las contraseñas compartidas del EQUIPO (sibana.cl+equipo@gmail.com y
    // sibana.cl+buenosaires@gmail.com) se apagaron el 05/10/2026: desde ahí
    // cada especialista entra con su propia cuenta (ver "Pedidos de acceso").
    // Esas dos cuentas se pueden borrar en Firebase Authentication (ya no
    // están aquí, así que es seguro).
    function puedeSede(sede) {
      return conCuenta() && (
        correo() == 'juandiego2577+duenos@gmail.com'
        || usuarioActivoDe(sede)
      );
    }

    // ---------------- Usuarios personales (cada especialista con el suyo) ----------------
    // Cada persona del equipo tiene su propia cuenta de Firebase Auth y un
    // documento sibana-usuarios/<uid de su cuenta> con su sede, rol y si está
    // activa. Solo los dueños crean o cambian esos documentos (desde la agenda,
    // Más → Equipo). Cualquiera puede crearse una cuenta de Firebase (hace
    // falta para la sesión anónima de la ficha), pero sin documento aquí no
    // tiene acceso a nada. Para sacar a alguien: activo = false (no se borra,
    // queda el registro de quién fue).
    function tieneUsuario() {
      return conCuenta()
        && exists(/databases/$(database)/documents/sibana-usuarios/$(request.auth.uid));
    }
    function datosUsuario() {
      return get(/databases/$(database)/documents/sibana-usuarios/$(request.auth.uid)).data;
    }
    function usuarioActivoDe(sede) {
      return tieneUsuario() && datosUsuario().activo == true
        && (datosUsuario().rol == 'duenos'
            || (datosUsuario().rol == 'especialista' && datosUsuario().sede == sede));
    }
    // Rol "lector": solo puede LEER la agenda de su sede (no guardar, ni ver
    // respaldos ni fichas). Es para el script de correos post-tratamiento, que
    // guarda su contraseña en Google: así, aunque alguien la sacara de ahí, no
    // podría cambiar ni borrar nada.
    function lectorDe(sede) {
      return tieneUsuario() && datosUsuario().activo == true
        && datosUsuario().rol == 'lector' && datosUsuario().sede == sede;
    }
    function esDueno() {
      return conCuenta() && (
        correo() == 'juandiego2577+duenos@gmail.com'
        || (tieneUsuario() && datosUsuario().activo == true && datosUsuario().rol == 'duenos')
      );
    }
    // "nombre" es el de la lista de Especialistas de la agenda (el que llevan
    // sus citas y vales); "nombreCompleto" es el que ella escribió al crear su
    // cuenta. "usuario" solo lo tienen las cuentas viejas de usuario corto
    // (ej. la del script de correos); las nuevas entran con su propio correo.
    function usuarioValido(d) {
      return d.keys().hasOnly(['usuario', 'nombre', 'nombreCompleto', 'email', 'sede', 'rol',
                               'activo', 'creadoEn', 'actualizadoEn'])
        && (!('usuario' in d) || (d.usuario is string && d.usuario.matches('^[a-z0-9]{3,20}$')))
        && (!('nombreCompleto' in d) || (d.nombreCompleto is string && d.nombreCompleto.size() <= 80))
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
        && d.email is string && d.email.size() <= 100
        && d.sede in ['santiago', 'buenosaires']
        && d.rol in ['especialista', 'duenos', 'lector']
        && d.activo is bool;
    }
    match /sibana-usuarios/{uid} {
      allow read: if esDueno() || (conCuenta() && request.auth.uid == uid);
      allow create, update: if esDueno() && usuarioValido(request.resource.data);
    }

    // ---------------- Pedidos de acceso ("Crear cuenta") ----------------
    // Cada especialista crea su propia cuenta en la pantalla de entrada (nombre
    // y apellido, su correo, su contraseña) y deja aquí un pedido de acceso.
    // Con eso NO puede ver nada: recién cuando un dueño lo aprueba (Más →
    // Equipo, eligiendo quién es en la lista de Especialistas) se crea su
    // documento en sibana-usuarios y el pedido se borra.
    match /sibana-solicitudes/{uid} {
      allow read: if esDueno() || (conCuenta() && request.auth.uid == uid);
      allow create: if conCuenta() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/sibana-usuarios/$(uid))
        && request.resource.data.keys().hasOnly(['nombreCompleto', 'email', 'creadaEn'])
        && request.resource.data.nombreCompleto is string
        && request.resource.data.nombreCompleto.size() > 1
        && request.resource.data.nombreCompleto.size() <= 80
        && request.resource.data.email == request.auth.token.email;
      // Rechazar: el pedido queda marcado (así no vuelve a aparecer solo).
      allow update: if esDueno()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rechazada', 'rechazadaEn'])
        && request.resource.data.rechazada == true;
      allow delete: if esDueno();
    }

    match /sibana-agenda/{sede} {
      allow read: if puedeSede(sede) || lectorDe(sede);
      allow create, update: if puedeSede(sede);
    }

    // ---------------- Respaldos ----------------
    // Fecha ("YYYY-MM-DD") que lleva el nombre del respaldo, o '' si no es un
    // respaldo con fecha (ej. el índice).
    function fechaDeRespaldo(id) {
      return id.matches('^[a-z]+_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ? id.split('_')[1]
        : (id.matches('^[a-z]+_antes-restaurar-[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$')
          ? id.split('_')[1][16:26]
          : '');
    }
    function diaDe(fecha) {
      return timestamp.date(int(fecha[0:4]), int(fecha[5:7]), int(fecha[8:10]));
    }
    function fechaCercanaAHoy(fecha) {
      return fecha != ''
        && diaDe(fecha) > request.time - duration.value(3, 'd')
        && diaDe(fecha) < request.time + duration.value(2, 'd');
    }
    function fechaVieja(fecha) {
      return fecha != ''
        && diaDe(fecha) < request.time - duration.value(29, 'd');
    }

    match /sibana-agenda-respaldos/{respaldo} {
      allow read: if puedeSede(respaldo.split('_')[0]);
      allow create, update: if puedeSede(respaldo.split('_')[0])
        && respaldo == respaldo.split('_')[0] + '_indice';
      allow create: if puedeSede(respaldo.split('_')[0])
        && fechaCercanaAHoy(fechaDeRespaldo(respaldo));
      allow delete: if puedeSede(respaldo.split('_')[0])
        && fechaVieja(fechaDeRespaldo(respaldo));
    }

    // ---------------- Fichas de consentimiento ----------------
    // La firma: solo una imagen PNG (lo que produce el formulario al dibujar).
    function firmaValida(d) {
      return d.get('firmaDataUrl', null) == null
        || (d.firmaDataUrl is string
            && d.firmaDataUrl.size() < 900000
            && d.firmaDataUrl.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$'));
    }
    function textoOk(d, k) {
      return d.get(k, '') == null
        || (d.get(k, '') is string && d.get(k, '').size() <= 3000);
    }
    function siNoOk(d, k) {
      return d.get(k, null) == null || d.get(k, null) is bool;
    }
    // Exactamente lo que manda el formulario de Santiago (repo
    // sibana-consentimiento). Si se agrega un campo al formulario, hay que
    // agregarlo también acá, o las fichas nuevas no se podrán guardar.
    function fichaSantiagoValida(d) {
      return d.keys().hasOnly([
          'step', 'fecha', 'ciudad', 'nombre', 'rut', 'edad', 'telefono', 'email',
          'alergias', 'alergias_detalle', 'diabetes', 'hipertension', 'vih',
          'hepatitis', 'enf_inmunes', 'cond_piel', 'cond_piel_detalle',
          'herpes', 'herpes_detalle', 'proc_quimicos', 'proc_esteticos',
          'n_tratamientos', 'microblading', 'tatuaje', 'tiempo_anterior',
          'tecnica', 'diseno_aprobado', 'acepta_cuidados', 'acepta_datos',
          'acepta_terminos', 'declara_firma', 'firmaDataUrl',
          'nombre_buscar', 'submittedAtClient', 'submittedAt'])
        && firmaValida(d)
        && textoOk(d, 'fecha') && textoOk(d, 'ciudad') && textoOk(d, 'nombre')
        && textoOk(d, 'rut') && textoOk(d, 'edad') && textoOk(d, 'telefono')
        && textoOk(d, 'email') && textoOk(d, 'alergias_detalle')
        && textoOk(d, 'cond_piel_detalle') && textoOk(d, 'herpes_detalle')
        && textoOk(d, 'proc_quimicos') && textoOk(d, 'proc_esteticos')
        && textoOk(d, 'n_tratamientos') && textoOk(d, 'tiempo_anterior')
        && textoOk(d, 'tecnica') && textoOk(d, 'nombre_buscar')
        && textoOk(d, 'submittedAtClient')
        && siNoOk(d, 'alergias') && siNoOk(d, 'diabetes') && siNoOk(d, 'hipertension')
        && siNoOk(d, 'vih') && siNoOk(d, 'hepatitis') && siNoOk(d, 'enf_inmunes')
        && siNoOk(d, 'cond_piel') && siNoOk(d, 'herpes') && siNoOk(d, 'microblading')
        && siNoOk(d, 'tatuaje') && siNoOk(d, 'diseno_aprobado')
        && siNoOk(d, 'acepta_cuidados') && siNoOk(d, 'acepta_datos')
        && siNoOk(d, 'acepta_terminos') && siNoOk(d, 'declara_firma');
    }

    match /sibana-consentimientos/{ficha} {
      allow create: if request.auth != null && fichaSantiagoValida(request.resource.data);
      // Una ficha firmada NO se puede modificar (06/10/2026): nada de la agenda
      // ni del Panel la edita, y así nadie puede cambiar lo que la clienta
      // firmó. Si firmó mal, se firma de nuevo y se borra la mala.
      allow read, delete: if puedeSede('santiago');
    }

    // El formulario de Buenos Aires todavía no existe (va a tener DNI y quizás
    // otros campos): por ahora solo se exige que la firma sea una imagen.
    match /sibana-consentimientos-buenosaires/{ficha} {
      allow create: if request.auth != null && firmaValida(request.resource.data)
        && request.resource.data.size() <= 60;
      allow read, delete: if puedeSede('buenosaires');
    }
  }
}
